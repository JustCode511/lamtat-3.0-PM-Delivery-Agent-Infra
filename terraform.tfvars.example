# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored (may hold secrets).
aws_region          = "ap-southeast-1"
project_name        = "pm-agent"
environment         = "demo"
# Confirm the exact Sonnet APAC profile ID: aws bedrock list-inference-profiles --region ap-southeast-1
bedrock_model_id    = "apac.anthropic.claude-sonnet-4-6-v1:0"
lambda_architecture = "arm64"
log_retention_days  = 7
allowed_origins     = ["http://localhost:5173"]

# Real secret values go ONLY in terraform.tfvars (gitignored). These are placeholders.
# JWT_SECRET is generated by Terraform — do NOT list it here.
app_secrets = {
  JIRA_BASE_URL               = "https://your-site.atlassian.net"
  JIRA_EMAIL                  = "you@example.com"
  JIRA_API_TOKEN              = "REPLACE_ME"
  SLACK_WEBHOOK_URL           = "https://hooks.slack.com/services/xxx/yyy/zzz"
  SLACK_BOT_TOKEN             = "xoxb-REPLACE_ME"
  SLACK_CHANNEL_ID            = "C0XXXXXXX"
  LEADERSHIP_SLACK_CHANNEL_ID = "C0YYYYYYY"
}
